# Upload directories must never execute scripts.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc .cgi .pl .py
<FilesMatch "\.(php[0-9]?|phtml|phar|pht|inc|cgi|pl|py|shtml|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Upload directories must never execute scripts.
Options -Indexes -ExecCGI
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pht|shtml|cgi|pl|py|rb|sh|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(pdf|doc|docx|txt|zip)$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>
